{
    "metadata": [
        {
            "src": [
                {
                    "src": "..",
                    "files": [
                        "**/*.csproj"
                    ],
                    "exclude": [
                        "**/*.Test.csproj",
                        "Tools/ClangSharp/**/*.csproj",
                        "Tools/Gen/**/*.csproj"
                    ]
                }
            ],
            "dest": "api"
        }
    ],
    "build": {
        "content": [
            {
                "files": [
                    "**/*.{md,yml}"
                ],
                "exclude": [
                    "_site/**"
                ]
            }
        ],
        "resource": [
            {
                "files": [
                    "images/**"
                ]
            }
        ],
        "output": "_site",
        "template": [
            "default",
            "statictoc"
        ],
        "globalMetadata": {
            "_appName": "",
            "_appTitle": "",
            "_enableSearch": false,
            "pdf": false
        }
    }
}
